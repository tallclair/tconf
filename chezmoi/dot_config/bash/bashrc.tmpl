#!/bin/bash

export SHELL="$(which $0)"
export SHELL_NAME="bash"

# Common environment variables
{{ range $key, $value := .env.vars -}}
export {{ $key }}={{ $value | quote }}
{{ end -}}

# Common path fragments
{{ range .env.path -}}
eval expanded_path={{ . | quote }}
if [ -d "$expanded_path" ]; then
    case ":$PATH:" in
        *":$expanded_path:"*) ;;
        *) export PATH="$expanded_path:$PATH" ;;
    esac
fi
{{ end -}}

# Display welcome message
echo -en '\e[2;37m' # Dimmed
echo "// $(date "+%A, %B %d, %Y • %T %Z")"
echo "// $(whoami)@$(hostname) ($SHELL_NAME)"
echo -en '\e[0m' # Reset

# History configuration
# don't put duplicate lines or lines starting with space in the history.
HISTCONTROL=ignoreboth
# for setting history length
HISTSIZE=1000
HISTFILESIZE=2000
# append to the history file, don't overwrite it
shopt -s histappend

# check the window size after each command and, if necessary,
# update the values of LINES and COLUMNS.
shopt -s checkwinsize

# make less more friendly for non-text input files, see lesspipe(1)
[ -x /usr/bin/lesspipe ] && eval "$(SHELL=/bin/sh lesspipe)"

# set variable identifying the chroot you work in (used in the prompt below)
if [ -z "$debian_chroot" ] && [ -r /etc/debian_chroot ]; then
  debian_chroot=$(cat /etc/debian_chroot)
fi

if [ -x /usr/libexec/path_helper ]; then
	eval `/usr/libexec/path_helper -s`
fi

# enable programmable completion features
if ! shopt -oq posix; then
  # UGH! This is so slow!
  if [ -f /etc/bash_completion ]; then
    . /etc/bash_completion
  fi
  # Git
  if [ -f /usr/share/git/completion/git-completion.bash ]; then
    . /usr/share/git/completion/git-completion.bash
  fi
  if [ -f /usr/share/git/completion/git-prompt.sh ]; then
    . /usr/share/git/completion/git-prompt.sh
  elif [ -f /usr/local/etc/bash_completion.d/git-prompt.sh ]; then
    . /usr/local/etc/bash_completion.d/git-prompt.sh
  elif [ -f /opt/brew/opt/git/etc/bash_completion.d/git-prompt.sh ]; then
    . /opt/brew/opt/git/etc/bash_completion.d/git-prompt.sh
  fi

  if command -v kubectl &> /dev/null; then
    # Kubernetes bash completions.
    source <(kubectl completion bash)
  fi
fi

# Set REMOTE_ALIAS fallback
if [ -z "$REMOTE_ALIAS" ]; then
    if [ -n "$SSH_CLIENT" ] || [ -n "$SSH_CONNECTION" ] || { [ -z "$XDG_VTNR" ] && [ -z "$DISPLAY" ]; }; then
        export REMOTE_ALIAS="$(hostname)"
    fi
fi

{{ if eq .chezmoi.os "darwin" -}}
# Homebrew setup for macOS
# Try common Homebrew locations (Apple Silicon, Intel, etc.)
for brew_path in /opt/homebrew/bin/brew /usr/local/bin/brew /opt/brew/bin/brew "$HOME/homebrew/bin/brew"; do
    if [ -x "$brew_path" ]; then
        eval "$("$brew_path" shellenv)"
        break
    fi
done

[[ -r "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh" ]] && . "${HOMEBREW_PREFIX}/etc/profile.d/bash_completion.sh"

/usr/bin/ssh-add --apple-load-keychain -q

unalias ls  # Mac compatability fix

{{- end -}}

# Load modular configs in deterministic order
BASH_CONF_DIR="$HOME/.config/bash"

# 1. Load Aliases
if [ -f "$BASH_CONF_DIR/aliases" ]; then
    . "$BASH_CONF_DIR/aliases"
fi

# 2. Load Prompt (PS1 / Starship)
if [ -f "$BASH_CONF_DIR/ps1" ]; then
    . "$BASH_CONF_DIR/ps1"
fi

# 3. Load Private Config
if [ -f "$TCONF/priv/shell/bashrc" ]; then
    . "$TCONF/priv/shell/bashrc"
fi
