# Common environment variables
{{ range $key, $value := .env.vars -}}
set -gx {{ $key }} {{ $value | quote }}
{{ end -}}

# Common path fragments
{{ range .env.path -}}
if test -d {{ . | quote }}
    fish_add_path --path {{ . | quote }}
end
{{ end -}}

# Common aliases (functions in Fish)
{{ range $key, $value := .env.aliases -}}
alias {{ $key }} {{ $value | quote }}
{{ end -}}

# Common abbreviations
{{ range $key, $value := .env.abbreviations -}}
abbr -a {{ $key }} {{ $value | quote }}
{{ end -}}
