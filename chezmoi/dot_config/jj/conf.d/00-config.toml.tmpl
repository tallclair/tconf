[user]
name = "Tim Allclair"
email = {{ .email | quote }}

[ui]
editor = [{{ .editor | quote }}]
merge-editor = ":builtin"
conflict-marker-style = "git"

[colors]
red = "red"

[revset-aliases]
'closest_bookmark(to)' = 'heads(::to & bookmarks())'
"immutable_heads()" = "trunk() | tags() | remote_bookmarks(upstream)"

[aliases]
s = ["status"]
tug = ["bookmark", "move", "--from", "closest_bookmark(@)", "--to", "(@ & ~empty()) | parents(@ & empty())"]
