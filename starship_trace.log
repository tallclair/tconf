# 1. Structure: Scaffolding & Two-Line Layout
# separator = "[ │ ](separator)"
format = """\
[// ](separator dimmed)\
($username${env_var.REMOTE_ALIAS}[:](separator dimmed))\
$directory( ${env_var.SHPOOL_SESSION_NAME})\
([ // ](separator dimmed)${custom.jj}${custom.git})\
([ // ](separator dimmed)${env_var.STARSHIP_EXTRA})\
([ // ](separator dimmed)$status)\
$fill($cmd_duration) $time
[> ](command bold)"""

# format = """\
# [╭╢ ](frame)\
# ($username$hostname[:](separator))\
# $directory\
# ([ // ](separator dimmed)$git_branch$git_status)\
# [ ║](frame)\
# $status\
# $fill($cmd_duration) $time
# [╰╼ ](frame)"""

add_newline = true
command_timeout = 500

palette = "dark"
[palettes.dark]
separator = "white"
frame = "white"
command = "bright-white"
directory = "blue"
directory-faded = "bright-blue"
git = "purple"
userhost = "cyan"

[time]
disabled = false
format = '[\[$time\]]($style)'
time_format = "%T"
style = "white dimmed"

[directory]
style = "directory"
before_repo_root_style = "directory-faded"
repo_root_style = "directory"
read_only = "🔒"
truncation_length = 5
truncate_to_repo = false
truncation_symbol = '…/'

format = "[$path]($style)[$read_only]($read_only_style)"
repo_root_format = """\
[$before_root_path]($before_repo_root_style)\
[$repo_root]($repo_root_style)\
[$path]($style)[$read_only]($read_only_style)"""

# Note: this is used by custom.git even though it isn't in the main format string.
[git_branch]
symbol = " "
style = "git"
format = "[$symbol$branch]($style)"

[git_state]
format = '\([$state( $progress_current/$progress_total)]($style)\)'

[git_status]
ignore_submodules = true
stashed = ""
deleted = "x"
modified = "!"
staged = "+"
untracked = "?"
renamed = "~"
style = "git"
format = "([ $all_status]($style bold))"
disabled = true

[custom.jj]
description = "Jujutsu Status"
shell = ["sh", "-c"]
# Only run this module if we are inside a jj repository
when = "jj root"
# Format the output to look like: " main xyz12 (empty)"
command = '''jj --color=always log -r@ -n1 --no-graph --ignore-working-copy -T '" " ++ if(bookmarks, bookmarks ++ " ", "") ++ change_id.short(5) ++ if(conflict, label("red", " (conflict)")) ++ if(empty, " (empty)")' '''
#command = '''jj log -r@ -n1 --no-graph --ignore-working-copy -T '" " ++ if(bookmarks, bookmarks ++ " ", "") ++ change_id.short(5) ++ if(conflict, " [\\\\(conflict\\\\)](red)") ++ if(empty, " (empty)")' '''
style = "git"
format = "[$output]($style)"

[custom.git]
description = "Git Status (Disabled in JJ repos)"
shell = ["sh", "-c"]
# Run if in a git repo AND NOT in a jj repo
when = 'git rev-parse --is-inside-work-tree >/dev/null 2>&1 && ! jj root >/dev/null 2>&1'
# Call starship's native modules directly for branch and state
command = 'printf "%s%s" "$(starship module git_branch)" "$(starship module git_state)"'
format = "$output"

[username]
style_user = "userhost bold"
show_always = false
format = "[$user]($style)@"

[hostname]
style = "userhost bold"
ssh_only = true
format = "[$hostname]($style)"
disabled = true

[fill]
symbol = " "

[status]
disabled = false
style = "red bold"
success_symbol = ""
format = '[E:$status]($style)'

[cmd_duration]
min_time = 2000
style = "yellow"
format = ' [\($duration\)]($style)'

[env_var.STARSHIP_EXTRA]
description = "Miscellaneous environment variable to add arbitrary extra info."
style = "yellow"
format = "[$env_value]($style)"

[env_var.REMOTE_ALIAS]
description = "Display name for remote machine."
style = "userhost"
format = "[$env_value]($style)"

[env_var.SHPOOL_SESSION_NAME]
description = "shpoool session name"
style = "white"
format = '[\($env_value\)]($style)'
"
