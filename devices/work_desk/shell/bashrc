# Connect agents
if [[ -z "$SSH_CLIENT" ]] && [[ -z "$SSH_TTY" ]]; then
   # Only connect SSH agent if not running over SSH.
   # Optimization: Check if agent is already running to avoid slow keychain init (~0.6s)
   if [ -f "$HOME/.keychain/${HOSTNAME}-sh" ]; then
       . "$HOME/.keychain/${HOSTNAME}-sh"
   fi
   
   if [ -z "$SSH_AGENT_PID" ] || ! kill -0 "$SSH_AGENT_PID" 2>/dev/null; then
       eval $(keychain --eval --quiet --quick gh_tallclair google_compute_engine)
   fi
fi

if [[ -e "${HOME}/.gpg-agent-info" ]]; then
   source ${HOME}/.gpg-agent-info
fi

# The next line updates PATH for the Google Cloud SDK.
if [ -f ${HOME}/opt/google-cloud-sdk/path.bash.inc ]; then
  . "${HOME}/opt/google-cloud-sdk/path.bash.inc"
fi

# The next line enables shell command completion for gcloud.
if [ -f ${HOME}/opt/google-cloud-sdk/completion.bash.inc ]; then
   . "${HOME}/opt/google-cloud-sdk/completion.bash.inc"
fi

# Kubernetes bash completions.
function load_cached_completion() {
  local cmd=$1
  local cache_dir="${HOME}/.cache/completions"
  local cache_file="${cache_dir}/${cmd}.bash"

  if ! command -v "$cmd" &> /dev/null; then
    return
  fi

  mkdir -p "$cache_dir"

  local bin_path="$(command -v "$cmd")"

  # Regenerate if cache doesn't exist or binary is newer
  if [[ ! -f "$cache_file" ]] || [[ "$bin_path" -nt "$cache_file" ]]; then
    "$cmd" completion bash > "$cache_file" 2>/dev/null
  fi

  source "$cache_file"
}

load_cached_completion kubectl
load_cached_completion kind
unset -f load_cached_completion

if [ -d "$HOME/.cargo/bin" ]; then
   export PATH="$HOME/.cargo/bin:$PATH"
fi

if [ -d "/usr/local/kubebuilder/bin" ]; then
   export PATH="$PATH:/usr/local/kubebuilder/bin"
fi


if command -v fnm &> /dev/null; then
  eval "$(fnm env --use-on-cd --shell bash)"
fi
